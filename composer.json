{
    "name": "getmetty/metty-php",
    "description": "PHP client for the Metty Search and Catalog APIs.",
    "type": "library",
    "keywords": [
        "metty",
        "search",
        "catalog",
        "ecommerce",
        "psr-18"
    ],
    "homepage": "https://docs.metty.eu/client/php",
    "license": "MIT",
    "support": {
        "docs": "https://docs.metty.eu/client/php",
        "issues": "https://github.com/getmetty/metty-php/issues",
        "source": "https://github.com/getmetty/metty-php"
    },
    "require": {
        "php": ">=8.1",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-factory-implementation": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Metty\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Metty\\Client\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "stan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
